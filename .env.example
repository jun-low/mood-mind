NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/new-user
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/new-user
